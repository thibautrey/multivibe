<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>MultiVibe</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>cloud.multivibe.chat</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>multivibe-chat</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>MultiVibe utilise le micro lorsque vous démarrez une dictée ou une conversation vocale. En conversation vocale, l’audio est transmis temporairement au service sélectionné et n’est pas conservé.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>MultiVibe transcrit votre voix sur cet appareil pour préparer un message modifiable. Le texte est transmis au modèle uniquement lorsque vous touchez Envoyer.</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Consulter et modifier vos événements lorsque vous utilisez les outils de calendrier de MultiVibe.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Consulter et modifier vos rappels lorsque vous utilisez les outils de rappels de MultiVibe.</string>
<key>NSContactsUsageDescription</key>
<string>Rechercher et ouvrir vos contacts lorsque vous utilisez les outils de contacts de MultiVibe.</string>
<key>NSLocationWhenInUseUsageDescription</key>
<string>Indiquer votre position lorsque vous le demandez à l’agent local.</string>
</dict>
</plist>
