node_modules
web/node_modules
dist
web-dist
target
native/*.node
.env
web/*.tsbuildinfo
packages/ui/public/assets/brand/
data/*

# Local deployment overrides hold operator credentials and must never be committed.
docker-compose.override.yml
DEPLOY.local.md

# CCE (code-context-engine)
# CCE local cache (per-machine, not for version control)
.cce/
.mcp.json
# Claude Code local settings
.claude/
assets/brand/.DS_Store
native/ios/.DS_Store
artifacts/local-macos/*.dmg
# Locally built installers are hundreds of megabytes and belong on a release, not
# in the tree. `git add -A` silently swept one in and GitHub rejected the push.
release/*.dmg
release/*.tar.gz
artifacts/.DS_Store

# Swift package build and local workspace data
.build/
.swiftpm/

# Local DSH SDK audit and isolated runtime fixtures (never publish).
.dsh-plugin-dev/
plugins/dsh-multivibe/*.tgz
.DS_Store

# Incremental TypeScript build state
*.tsbuildinfo

# Marketplace broker runtime state (secrets live in .env, data in data/).
services/marketplace/data/

# Xcode per-user state (never shared, contains local usernames and window state).
xcuserdata/
*.xcuserstate
