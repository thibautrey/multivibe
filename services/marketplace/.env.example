# Copy to .env (chmod 600) and fill in. Never commit the real file.
#
# Approves instance enrollments and grants access to /api/*.
MARKETPLACE_OPERATOR_TOKEN=
# 32-byte hex key (openssl rand -hex 32) sealing instance secrets at rest.
MARKETPLACE_ENCRYPTION_KEY=
# Public HTTPS base URL of this broker (enrollment links, browser returns).
MARKETPLACE_PUBLIC_URL=http://127.0.0.1:1460
# Stripe platform key. Empty keeps the broker up without checkout.
STRIPE_SECRET_KEY=
# Both webhook endpoints are required for direct charges.
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Default commission for new instances, in basis points (500 = 5%).
MARKETPLACE_COMMISSION_BPS=500
