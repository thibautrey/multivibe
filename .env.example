# Instance environment (optional settings).
#
# Copy the relevant lines into the instance `.env` beside docker-compose.yml or
# export them before starting MultiVibe. Never commit a filled-in file.

# --- Transactional email (SMTP) ---------------------------------------------
# Account emails stay disabled unless this is exactly "true".
MULTIVIBE_SMTP_ENABLED=false
# SMTP relay hostname. Required when email is enabled.
SMTP_HOST=
# 587 uses STARTTLS, 465 usually uses implicit TLS (see SMTP_SECURE).
SMTP_PORT=587
# true = implicit TLS from the first byte (usually port 465).
# false = STARTTLS is required; a server that cannot upgrade fails delivery.
SMTP_SECURE=false
# Optional SMTP AUTH credentials. Set both or neither.
SMTP_USER=
SMTP_PASSWORD=
# Envelope From header. The default is the branded no-reply address.
SMTP_FROM=MultiVibe <no-reply@multivibe.cloud>
# Optional Reply-To header.
SMTP_REPLY_TO=
# CTA buttons link to <MULTIVIBE_CLOUD_API_BASE_URL>/billing.
# MULTIVIBE_CLOUD_API_BASE_URL=https://app.multivibe.cloud
